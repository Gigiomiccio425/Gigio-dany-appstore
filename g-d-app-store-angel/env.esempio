# Modello del file dei segreti di ANGEL su umbrelOS.
#
# COSA FARNE: copiarlo sul tuo Umbrel come
#     ~/umbrel/app-data/g-d-app-store-angel/.env
# e riempirlo. Docker Compose lo legge da solo perché è la cartella del
# progetto dell'app. Questo file resta un modello: non metterci valori veri,
# la repository dello store è pubblica.
#
#   sudo nano ~/umbrel/app-data/g-d-app-store-angel/.env
#   sudo ~/umbrel/scripts/app restart g-d-app-store-angel

# ── Discord ──────────────────────────────────────────────────
# Developer Portal → Bot → Reset Token. Nella stessa pagina vanno accesi
# tutti e tre i Privileged Gateway Intents: Presence, Server Members,
# Message Content. Se ne manca uno Discord rifiuta con «Used disallowed
# intents» e il bot riparte in ciclo senza collegarsi.
DISCORD_TOKEN=

# Developer Portal → General Information.
DISCORD_CLIENT_ID=

# Developer Portal → OAuth2. Serve solo al pannello.
DISCORD_CLIENT_SECRET=

# Il tuo ID Discord (Impostazioni → Avanzate → Modalità sviluppatore, poi
# tasto destro sul tuo nome → Copia ID utente). Più ID separati da virgola.
OWNER_IDS=

# ── Segreti ──────────────────────────────────────────────────
# Due segreti DIVERSI fra loro:  openssl rand -hex 32
#
# SESSION_SECRET firma i cookie del pannello: cambiarlo scollega tutti, niente
# di più. ENCRYPTION_KEY cifra i token dentro il database: se questa
# installazione affianca o sostituisce un'altra, va copiata IDENTICA da
# quella, non rigenerata — con una chiave diversa i dati esportati dal nodo
# di emergenza non sarebbero rileggibili al rientro.
SESSION_SECRET=
ENCRYPTION_KEY=

# ── Indirizzo del pannello ───────────────────────────────────
# Deve combaciare esattamente con quello che digiti nel browser, porta
# compresa, e va registrato come redirect OAuth2 aggiungendo in fondo
# /api/auth/callback . Se non combacia, l'accesso fallisce con «stato non
# valido».
PUBLIC_URL=http://umbrel.local:7801

# ── Facoltativi ──────────────────────────────────────────────
# Password del database interno all'app. Non è esposto fuori dalla rete
# dell'app; cambiarla dopo il primo avvio richiede di cancellare
# app-data/g-d-app-store-angel/data/postgres, cioè tutti i dati.
ANGEL_DB_PASSWORD=angel_umbrel_local

PANEL_OWNERS_ONLY=true
THREAT_FEEDS_ENABLED=true
GOOGLE_SAFE_BROWSING_KEY=
LOG_LEVEL=info
TZ=Europe/Rome
BACKUP_KEEP=14

# Bot Twitch: senza queste tre resta spento.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_PUBLIC_URL=
